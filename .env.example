DISCORD_BOT_TOKEN=
INTERACTIVE_CHANNEL_ID=

# comma-separated channel names to passively monitor - any new message there
# gets evaluated by every persona, who react in the interactive channel if
# they genuinely have something to add (e.g. news/intel feed channels)
WATCHED_CHANNELS=

# your Discord user ID - personas can @-ping you when something's worth your
# attention (right-click your name in Discord > Copy User ID, Developer Mode on)
DISCORD_USER_ID=

# One webhook per persona (same channel is fine - each still posts under its
# own name/avatar).
WEBHOOK_PERSONA_ANALYST=
WEBHOOK_PERSONA_SKEPTIC=
WEBHOOK_PERSONA_PHILOSOPHER=
WEBHOOK_PERSONA_CONFUSED=
WEBHOOK_PERSONA_CYNIC=
WEBHOOK_PERSONA_MAVERICK=
WEBHOOK_PERSONA_SCRIBE=

OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:14b

# St. Louis Fed FRED API key (free, https://fred.stlouisfed.org/docs/api/api_key.html)
# - real macro/economic data (CPI, unemployment, Fed funds rate, etc.)
FRED_API_KEY=
